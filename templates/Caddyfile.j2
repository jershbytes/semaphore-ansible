{% if semaphore_caddy_domain | length > 0 %}
{{ semaphore_caddy_domain }} {
  reverse_proxy {{ semaphore_caddy_upstream }}

{% if semaphore_caddy_cloudflare_api_token | length > 0 %}
  tls {
    dns cloudflare {$CLOUDFLARE_API_TOKEN}
{% if semaphore_caddy_dns_resolvers | length > 0 %}
    resolvers {{ semaphore_caddy_dns_resolvers | join(' ') }}
{% endif %}
  }
{% endif %}
}
{% else %}
:443 {
  reverse_proxy {{ semaphore_caddy_upstream }}

  # Internal TLS for IP/local testing; trust warning is expected unless CA is installed.
  tls internal
}
{% endif %}
