[Unit]
Description=Semaphore UI
Documentation=https://semaphoreui.com/docs
Wants=network-online.target
After=network-online.target
ConditionPathExists={{ semaphore_bin_path }}
ConditionPathExists={{ semaphore_config_file }}
{% if semaphore_db_dialect == 'mysql' %}
Requires=mysql.service
After=mysql.service
{% endif %}
{% if semaphore_db_dialect == 'postgres' %}
Requires=postgresql.service
After=postgresql.service
{% endif %}

[Service]
User={{ semaphore_user }}
Group={{ semaphore_group }}
Restart=always
RestartSec=10s
Environment="LANG=en_US.UTF-8"
Environment="LC_ALL=en_US.UTF-8"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:{{ semaphore_user_home }}/.local/bin"
ExecStart={{ semaphore_bin_path }} server --config {{ semaphore_config_file }}
ExecReload=/bin/kill -HUP $MAINPID
{% if semaphore_syslog_enabled | bool %}
StandardOutput=journal
StandardError=journal
SyslogIdentifier=semaphore
{% endif %}

[Install]
WantedBy=multi-user.target
